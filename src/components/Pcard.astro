---
const { event } = Astro.props;
---

<article>
    <img
        src=`https://kea-alt-del.dk/t7/images/webp/640/${event.id}.webp`
        alt="produktbillede"
    />
    <h2>{event.titel}</h2>
    <p>{event.beskrivelse},- kr.</p>
</article>

<style>
    article {
        padding: 1rem;
        border: 1px solid;
        background-color: wheat;
    }
    img {
        max-width: 100%;
    }
</style>
