---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {

const endpoint =
    "https://flxrgxrvxeximsskwubc.supabase.co/rest/v1/events?select=*";

const options = {
    headers: {
        apikey: "sb_publishable_blXxApPlyxDnCVHdrO_sEA__Nmc254r",
    },
};

  const response = await fetch(endpoint, options);
  const data: any[] = await response.json();

  return data.map((event) => {
    return {
      params: { id: event.id.toString() },
      props: { event },
    };
  });
}

const { id } = Astro.params;
const { event } = Astro.props;
---
<Layout>
    <h1>{event.titel}</h1>
    <p>{event.beskrivelse}</p>
     <img
        src=`https://flxrgxrvxeximsskwubc.supabase.co/storage/v1/object/public/events/${event.id}/primary.jpg`
        alt="eventbillede"
    />
</Layout>

<style>
    p{
        color: blueviolet;
    }
</style>