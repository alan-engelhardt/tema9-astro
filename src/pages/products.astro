---
import Layout from "../layouts/Layout.astro";
import Pcard from "../components/Pcard.astro";
const endpoint =
    "https://flxrgxrvxeximsskwubc.supabase.co/rest/v1/events?select=*";

const options = {
    headers: {
        apikey: "sb_publishable_blXxApPlyxDnCVHdrO_sEA__Nmc254r",
    },
};

const data = await fetch(endpoint, options).then((res) => res.json());
console.log(data);
---

<Layout>
    <h2>Vores produkter</h2>
    <section>
        {data.map((produkt) => <Pcard {produkt} />)}
    </section>
</Layout>

<style>
    section {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
</style>
